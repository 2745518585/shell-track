<Window
    x:Class="ShellTrack.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShellTrack.Desktop"
    Title="Shell Track">
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16" UseLayoutRounding="True" SizeChanged="RootGrid_SizeChanged" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <x:Double x:Key="LogLineHeight">20</x:Double>
            <DataTemplate x:Key="LogLineTemplate">
                <Grid ColumnSpacing="12" Padding="8,0,12,0" MinHeight="{StaticResource LogLineHeight}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NumberLabel}" FontFamily="Cascadia Mono,Consolas" FontSize="13" LineHeight="{StaticResource LogLineHeight}" LineStackingStrategy="BlockLineHeight" TextAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas" FontSize="13" LineHeight="{StaticResource LogLineHeight}" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Top" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Shell Track" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="TaskCount" Text="任务与输出" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="RestoreHiddenButton" Content="恢复隐藏任务" Click="RestoreHidden_Click" Visibility="Collapsed" Padding="0" ToolTipService.ToolTip="重新显示所有隐藏的任务卡片" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OverviewButton" Content="总览" Click="Overview_Click" IsEnabled="False" ToolTipService.ToolTip="取消选择，同时监看所有任务（Esc）" />
                <TextBlock Text="卡片预览" VerticalAlignment="Center" FontSize="12" />
                <Button Content="−" Click="PreviewDefaultLess_Click" ToolTipService.ToolTip="减少所有卡片的可见行数" />
                <TextBlock x:Name="PreviewDefaultLabel" Text="5 行" VerticalAlignment="Center" FontSize="12" />
                <Button Content="＋" Click="PreviewDefaultMore_Click" ToolTipService.ToolTip="增加所有卡片的可见行数" />
                <ToggleButton x:Name="DetailsToggle" Content="详情" IsChecked="True" Click="DetailsToggle_Click" ToolTipService.ToolTip="显示或收起任务详情" />
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="退出" Click="Exit_Click" ToolTipService.ToolTip="退出查看器，后台任务继续运行" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TaskColumn" Width="*" /><ColumnDefinition x:Name="OutputColumn" Width="0" /></Grid.ColumnDefinitions>
            <ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="6" Padding="2,6" RightTapped="TaskCard_RightTapped">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="0,6">
                                <local:OutputPreview Lines="{Binding PreviewLines}" Rows="{Binding PreviewRows}" LineHeight="{StaticResource LogLineHeight}" LineTemplate="{StaticResource LogLineTemplate}" />
                            </Border>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NotificationLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="−" Padding="6,2" Click="PreviewLess_Click" IsEnabled="{Binding CanShrinkPreview}" ToolTipService.ToolTip="减少此卡片的可见行数" />
                                <TextBlock Grid.Column="2" Text="{Binding PreviewRowLabel}" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="＋" Padding="6,2" Click="PreviewMore_Click" IsEnabled="{Binding CanGrowPreview}" ToolTipService.ToolTip="增加此卡片的可见行数" />
                                <Button Grid.Column="4" Content="⋯" Padding="6,2" Click="CardActions_Click" ToolTipService.ToolTip="隐藏任务卡片" AutomationProperties.Name="任务卡片操作" />
                            </Grid>
                            <TextBlock Text="{Binding PreviewNotice}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding PreviewNoticeVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Column="1" x:Name="ContentGrid" ColumnSpacing="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LogTitle" Text="选择一个任务" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LogSummary" Text="选择左侧任务，查看实时输出和历史日志。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <CheckBox x:Name="FollowToggle" Content="跟随输出" IsChecked="True" Click="FollowToggle_Click" />
                            <CheckBox x:Name="NotificationToggle" Content="完成通知" IsEnabled="False" Click="NotificationToggle_Click" ToolTipService.ToolTip="在任务结束前开启或关闭通知" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ActionsButton" Content="操作" IsEnabled="False">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="CopyButton" Text="复制日志" Click="Copy_Click" />
                                    <MenuFlyoutItem x:Name="ExportButton" Text="导出原始输出" Click="Export_Click" />
                                    <MenuFlyoutItem x:Name="FolderButton" Text="打开工作目录" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="通知条件…" Click="NotificationConditions_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="StopButton" Text="终止任务" Click="Stop_Click" IsEnabled="False" />
                                    <MenuFlyoutItem x:Name="DeleteButton" Text="删除历史" Click="Delete_Click" IsEnabled="False" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="LogList" ItemTemplate="{StaticResource LogLineTemplate}" SelectionMode="Single" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0" KeyDown="LogList_KeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Top" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="20" /><Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </Grid>
                <Border Grid.Column="1" x:Name="DetailsPanel" Visibility="Collapsed" Margin="16,0,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                            <TextBlock Text="任务详情" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="DetailTitle" Text="选择一个任务" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="DetailStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="日志按逻辑行编号。长行自动换行，悬停高亮当前行，点击可固定选中。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="ConnectionStatus" Text="正在连接后台…" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
